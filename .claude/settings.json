{
  "permissions": {
    "allow": [
      "Read(./.env.example)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(sed -i*)",
      "Bash(git rm *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)"
    ]
  }
}
