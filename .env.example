# Copy this file to .env and fill in what you need. .env is not committed.

# Personal access token. Optional: raises the rate limit from 60 to 5000
# requests per hour. A fine-grained token without any permissions is enough
# for public repositories.
GITHUB_TOKEN=

# How long a cached response stays valid, in seconds (default 3600).
GH_COMMITS_CACHE_TTL=3600

# Only for running without Docker; in Docker the cache lives in the `cache`
# volume, so leave this unset there.
# GH_COMMITS_CACHE_PATH=~/.cache/github-commits
